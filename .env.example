# ===== قاعدة البيانات =====
# محليًا: اتركها فارغة ← يُستعمل الملف data/mishkat.db تلقائيًا
# على Vercel: اربط Turso من تبويب Storage (يضيف TURSO_DATABASE_URL و TURSO_AUTH_TOKEN تلقائيًا)
# أو ضعها يدويًا: libsql://اسم-القاعدة.turso.io
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# ===== جلسات لوحة التحكم (إجباري) =====
# سلسلة عشوائية طويلة (32 حرفًا على الأقل). لتوليدها:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# ===== أول حساب في لوحة التحكم =====
# يُنشأ تلقائيًا عند النشر إذا لم يوجد أي حساب بعد. بعد أول دخول غيّر كلمة السر من اللوحة
# ويمكنك حذف هذين المتغيرين.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ===== رفع الصور من لوحة التحكم (Vercel Blob) =====
# يُضاف تلقائيًا عند ربط Blob بالمشروع على Vercel. محليًا: اتركه فارغًا ← تُحفظ الصور في public/uploads
BLOB_READ_WRITE_TOKEN=

# ===== رابط الموقع (لمحركات البحث وروابط المشاركة) =====
# على Vercel يُستعمل رابط المشروع تلقائيًا إن تُرك فارغًا. ضع الدومين النهائي عند ربطه.
NEXT_PUBLIC_SITE_URL=
